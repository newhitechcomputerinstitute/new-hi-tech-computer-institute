rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid == "rDDW4TmIvNVlqTgzHGCpAAHkIPU2";
    }

    // Public enquiry form: write-only for visitors. Admin can read/manage.
    match /enquiries/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['name','phone','course','city','message','status','createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 1 &&
        request.resource.data.phone is string && request.resource.data.phone.size() >= 10 &&
        request.resource.data.course is string;
      allow read, update, delete: if isAdmin();
    }

    match /students/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /tests/{testId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == "Published");
      allow create, update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow create: if signedIn() &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['studentUid','testId','answers','submittedAt']);
      allow read: if isAdmin() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /courseFees/{id} {
      allow read, write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /notes/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == "Published");
      allow create, update, delete: if isAdmin();
    }

    match /certificates/{certificateNumber} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /notices/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == "Published");
      allow create, update, delete: if isAdmin();
    }

    match /batches/{id} {
      allow read, write: if isAdmin();
    }

    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}